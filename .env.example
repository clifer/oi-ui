OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODELS=gpt-6-astra,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.6
XAI_MODELS=grok-4.6,grok-4.5,grok-4.3
XAI_REASONING_EFFORT=medium

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-pro-preview,gemini-2.5-pro,gemini-2.5-flash
GEMINI_THINKING_LEVEL=medium

PORT=3000
CONSTITUTION_URL=https://raw.githubusercontent.com/clifer/open-inquiry-constitution/main/CONSTITUTION.md

# Public demo safeguards
# Optional access code required by /api/inquire when set.
OI_ACCESS_TOKEN=
# Completed inquiry runs allowed per client per rolling hour.
OI_HOURLY_RUN_LIMIT=20
# Completed inquiry runs allowed server-wide per UTC day.
OI_DAILY_RUN_LIMIT=200
# Optional per-provider daily limits. 0 means inherit OI_DAILY_RUN_LIMIT.
OI_OPENAI_DAILY_RUN_LIMIT=0
OI_XAI_DAILY_RUN_LIMIT=0
OI_GEMINI_DAILY_RUN_LIMIT=0
# Disable provider web search even if the browser asks for it.
OI_ALLOW_WEB_SEARCH=true
# Only enable behind a trusted reverse proxy.
OI_TRUST_PROXY=0
